# Supabase public — utilisé par le navigateur et le serveur avec RLS
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon

# IA — au moins un fournisseur doit être configuré côté serveur
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING=low
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_ORDER=gemini,groq,openrouter,custom

# Recherche web publique sans clé : auto, always ou off
WEB_RESEARCH_MODE=auto

# Endpoint LLM personnalisé facultatif
CUSTOM_LLM_URL=
CUSTOM_LLM_KEY=
CUSTOM_LLM_MODEL=

# Sécurité du cron Vercel — ne jamais préfixer par NEXT_PUBLIC_
CRON_SECRET=choisir-un-secret-long-et-aleatoire

# Clé service Supabase : uniquement pour les tâches serveur de confiance.
# La route principale de mission n’en a pas besoin.
SUPABASE_SERVICE_ROLE_KEY=
